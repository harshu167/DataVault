# DataVault Configuration Template
# Copy to .env or application-local.properties for local development.
# Configure as environment variables in Railway for production.
# NEVER commit real credentials, passwords, or keys to version control.

# Server Port (dynamically assigned by Railway in production, defaults to 8080)
PORT=8080

# Database Configuration (Aiven MySQL or Local MySQL)
# Option A: Full JDBC Connection URL (Recommended for Aiven Cloud MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://your-aiven-mysql-host:27514/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_db_password

# Option B: Individual database parameters (Useful for local development)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=datavault
DB_USER=root
DB_PASSWORD=your_local_password
DB_SSL_MODE=PREFERRED

# JWT Authentication
# Secret must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=your_minimum_256_bit_jwt_secret_key_here_keep_safe

# DataVault AES-GCM 256-bit Encryption Key (32 characters / 256 bits)
DATAVAULT_ENCRYPTION_KEY=your_32_byte_aes_gcm_encryption_key_here

# File Storage Path
DATAVAULT_UPLOAD_DIR=./uploads/documents

# Allowed Frontend Origins for CORS (comma-separated, e.g. Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app
